<?xml version="1.0"?>
<ruleset name="UpturnStudio Ai">
    <description>Magento 2 coding standard for UpturnStudio_Ai.</description>
    <file>.</file>
    <arg name="extensions" value="php,xml"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <exclude-pattern>*/Test/*</exclude-pattern>
    <rule ref="Magento2">
        <!-- The SDK mirrors Laravel's static entry points (Ai::build(), Agent::fake(), Stop::when()) on purpose. -->
        <exclude name="Magento2.Functions.StaticFunction"/>
    </rule>
    <!-- A marker interface for exceptions; "FailoverableExceptionInterface" would read worse in catch blocks. -->
    <rule ref="Magento2.NamingConvention.InterfaceName">
        <exclude-pattern>*/Exceptions/FailoverableException.php</exclude-pattern>
    </rule>
</ruleset>
